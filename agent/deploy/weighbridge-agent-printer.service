[Unit]
Description=Weighbridge SK-820 printer Agent
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/weighbridge-agent
EnvironmentFile=%h/weighbridge-agent/agent.env
ExecStart=/usr/bin/flock -n %h/weighbridge-agent/agent.lock %h/weighbridge-agent/bin/weighbridge-agent-printer --env-file %h/weighbridge-agent/agent.env --state-dir %h/weighbridge-agent/state
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
UMask=0077

[Install]
WantedBy=default.target
