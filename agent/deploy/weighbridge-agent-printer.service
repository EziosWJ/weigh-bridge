[Unit]
Description=Weighbridge local scale and printer Agent
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/weighbridge/agent
ExecStart=/usr/bin/flock -n %h/weighbridge/agent/agent.lock %h/weighbridge/current/bin/weighbridge-agent-printer --env-file %h/weighbridge/agent/agent.env --state-dir %h/weighbridge/agent/state
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
