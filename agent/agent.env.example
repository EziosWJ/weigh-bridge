# 复制到仓库根目录 agent.env 后修改；真实密钥只保存在忽略的本地文件中。
# 地址、Agent 身份、地磅编号和密钥须与本地业务服务一致。
WEIGHBRIDGE_SERVER_URL="http://127.0.0.1:8900"
WEIGHBRIDGE_AGENT_ID="scale-agent-1"
WEIGHBRIDGE_SCALE_ID=1
APP_WEIGHING__AGENT_KEY="replace-with-local-agent-key"
WEIGHBRIDGE_PRINT_QUEUE="Aisino-SK820-raw"

# 先启动 task device:d12，再用其显示的实际串口路径替换下方示例。
WEIGHBRIDGE_SERIAL_ENABLED=true
WEIGHBRIDGE_SERIAL_PORT="/dev/pts/3"
WEIGHBRIDGE_SERIAL_BAUD=9600
WEIGHBRIDGE_SERIAL_PROTOCOL="keli-d12-tf05"
WEIGHBRIDGE_SERIAL_WEIGHT_UNIT="t"
WEIGHBRIDGE_SERIAL_STALE_MS=1000

# 只验证重量时可以留空；抓拍须同时配置前后地址。
WEIGHBRIDGE_CAMERA_FRONT_URL=""
WEIGHBRIDGE_CAMERA_REAR_URL=""
WEIGHBRIDGE_CAMERA_TIMEOUT_MS=6000

# Optional shared MediaMTX mapping. Prefer saving/applying in device maintenance.
# Empty mode retains the legacy camera URLs above; never infer a migration.
# WEIGHBRIDGE_CAMERA_CONFIG="{\"mode\":\"mediamtx\",\"enabled\":true,\"rtspBase\":\"rtsp://127.0.0.1:8554\",\"whepBase\":\"http://REPLACE_MEDIA_LAN_IP:8889\",\"frontPath\":\"front\",\"rearPath\":\"rear\"}"
