# ADR 0030：Agent 只需填写 Server 地址，Server 在 agent.hello.ack 中分配本厂
# 唯一地磅。不再需要连接密钥、配对文件、人工 Agent／地磅编号。
WEIGHBRIDGE_SERVER_URL="http://127.0.0.1:18900"
WEIGHBRIDGE_PRINT_QUEUE="Aisino-SK820-raw"

# 仅配置 Agent 主机的实际串口路径与波特率；D12 tF=05、8N1、吨制和
# 1 秒无有效帧阈值固定，不再提供启用开关/协议/源单位/超时配置。
# 串口留空时按仅打印/未配置运行，维护连接保持可用。
WEIGHBRIDGE_SERIAL_PORT=""
WEIGHBRIDGE_SERIAL_BAUD=9600

# 打印校准参数由 Agent 维护页保存并应用；需要预置时可取消注释。
# WEIGHBRIDGE_PRINT_WIDTH_MM=175
# WEIGHBRIDGE_PRINT_OFFSET_X_MM=0
# WEIGHBRIDGE_PRINT_OFFSET_Y_MM=0
# WEIGHBRIDGE_FORM_LENGTH_MM=99
# WEIGHBRIDGE_PRINT_SCALE=1

# 摄像头、视频服务与识别配置已迁入 Server 摄像头页，本文件不再读取。
# 升级时旧的 WEIGHBRIDGE_CAMERA_* 字段会被清理，源地址保存在
# agent.env.legacy-camera.json，请在本厂摄像头页重新填写。
